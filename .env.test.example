# QA environment — written by `npm run qa:env` and `npm run qa:seed`.
# Copy to .env.test only if you want to point QA at a different Supabase
# project; by default both scripts fill it in for the LOCAL Supabase stack
# (`npx supabase start`). NEVER point this at the live project.

# --- Supabase (local stack; `npx supabase status -o env` prints these) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App settings for QA ---
MFA_ENFORCED=false
CRON_SECRET=qa-cron-secret
# Leave RESEND_API_KEY unset: invites and resets then show a copyable link.
QA_BASE_URL=http://localhost:3100

# --- Logins (strong random passwords, generated by the seed; never commit) ---
QA_PLATFORM_ADMIN_EMAIL=qa-platform-admin@example.com
QA_PLATFORM_ADMIN_PASSWORD=
QA_TEST_MANAGER_EMAIL=qa-manager@qa-test-care.example.com
QA_TEST_MANAGER_PASSWORD=
QA_TEST_TRAINER_EMAIL=qa-trainer@qa-test-care.example.com
QA_TEST_TRAINER_PASSWORD=
QA_TEST_STAFF_EMAIL=qa-staff@qa-test-care.example.com
QA_TEST_STAFF_PASSWORD=
QA_TEST_STAFF_NEW_EMAIL=qa-staff-new@qa-test-care.example.com
QA_TEST_STAFF_NEW_PASSWORD=
QA_EMPTY_MANAGER_EMAIL=qa-manager@qa-empty-care.example.com
QA_EMPTY_MANAGER_PASSWORD=
QA_OTHER_MANAGER_EMAIL=qa-manager@qa-other-care.example.com
QA_OTHER_MANAGER_PASSWORD=
QA_PORTAL_MANAGER_EMAIL=qa-manager@qa-portal-care.example.com
QA_PORTAL_MANAGER_PASSWORD=
QA_CANDIDATE_EMAIL=qa-candidate@example.com
QA_CANDIDATE_PASSWORD=

# --- Organisation ids (written by the seed, read by the tests) ---
QA_TEST_ORG_ID=
QA_EMPTY_ORG_ID=
QA_OTHER_ORG_ID=
QA_PORTAL_ORG_ID=
QA_PORTAL_DOMAIN=qa-portal.localhost
QA_PORTAL_API_KEY=
